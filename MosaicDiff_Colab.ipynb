        "#@title ⚙️ Formulir Input Video & Foto Kepala { run: \"auto\" }\n",
        "\n",
        "import os\n",
        "import base64\n",
        "from pathlib import Path\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "def display_preview(video_path: str, image_path: str):\n",
        "    html_cards = []\n",
        "    if os.path.isfile(video_path):\n",
        "        with open(video_path, 'rb') as f:\n",
        "            v_bytes = f.read()\n",
        "        v_b64 = base64.b64encode(v_bytes).decode('utf-8')\n",
        "        ext = Path(video_path).suffix.lstrip('.').lower()\n",
        "        mime = 'video/mp4' if ext in ['mp4', 'm4v'] else f'video/{ext}'\n",
        "        html_cards.append(f'''\n",
        "        <div style=\"display: inline-block; vertical-align: top; margin-right: 18px; padding: 12px; background: #1a1c23; border-radius: 8px; border: 1px solid #2e3440;\">\n",
        "            <h4 style=\"color: #e0a15a; margin: 0 0 8px 0; font-family: sans-serif;\">🎥 Video Target (Gerakan & Mimik Wajah)</h4>\n",
        "            <video width=\"380\" controls style=\"border-radius: 6px; max-height: 300px; background: #000;\">\n",
        "                <source src=\"data:{mime};base64,{v_b64}\" type=\"{mime}\">\n",
        "            </video>\n",
        "            <p style=\"color: #8892b0; margin: 4px 0 0 0; font-size: 11px; font-family: monospace;\">{Path(video_path).name}</p>\n",
        "        </div>\n",
        "        ''')\n",
        "    if os.path.isfile(image_path):\n",
        "        with open(image_path, 'rb') as f:\n",
        "            i_bytes = f.read()\n",
        "        i_b64 = base64.b64encode(i_bytes).decode('utf-8')\n",
        "        ext = Path(image_path).suffix.lstrip('.').lower()\n",
        "        mime = f'image/{ext}' if ext in ['png', 'webp'] else 'image/jpeg'\n",
        "        html_cards.append(f'''\n",
        "        <div style=\"display: inline-block; vertical-align: top; padding: 12px; background: #1a1c23; border-radius: 8px; border: 1px solid #2e3440;\">\n",
        "            <h4 style=\"color: #64b5f6; margin: 0 0 8px 0; font-family: sans-serif;\">👤 Foto Identitas Wajah Sumber</h4>\n",
        "            <img src=\"data:{mime};base64,{i_b64}\" width=\"220\" style=\"border-radius: 6px; max-height: 300px; object-fit: contain; background: #000;\">\n",
        "            <p style=\"color: #8892b0; margin: 4px 0 0 0; font-size: 11px; font-family: monospace;\">{Path(image_path).name}</p>\n",
        "        </div>\n",
        "        ''')\n",
        "    if html_cards:\n",
        "        display(HTML(''.join(html_cards)))\n",
        "\n",
