        "# @title 📥 YouTube Video Clipper with Duration Support\n",
        "# @markdown Masukkan link video. Anda bisa mengisi (START_TIME & END_TIME) ATAU (END_TIME & DURATION).\n",
        "\n",
        "URL = \"https://www.youtube.com/shorts/kRUIyOUDb38\" # @param {type:\"string\"}\n",
        "START_TIME = \"\" # @param {type:\"string\"}\n",
        "END_TIME = \"00:00:05\" # @param {type:\"string\"}\n",
        "DURATION = 5 # @param {type: \"integer\"} (dalam detik, misal: 30. Isi 0 jika tidak digunakan)\n",
        "\n",
        "import os\n",
        "import subprocess\n",
        "import random\n",
        "import string\n",
        "\n",
        "# Fungsi helper untuk konversi format waktu (HH:MM:SS atau MM:SS) ke detik\n",
        "def time_to_seconds(t_str):\n",
        "    if not t_str or t_str.strip() == \"\":\n",
        "        return 0\n",
        "    parts = list(map(int, t_str.split(':')))\n",
        "    if len(parts) == 3:\n",
        "        return parts[0] * 3600 + parts[1] * 60 + parts[2]\n",
        "    elif len(parts) == 2:\n",
        "        return parts[0] * 60 + parts[1]\n",
        "    return int(parts[0])\n",
        "\n",
        "# Fungsi helper untuk konversi detik kembali ke format MM:SS atau HH:MM:SS\n",
        "def seconds_to_time(sec):\n",
        "    sec = int(sec)\n",
        "    hours = sec // 3600\n",
        "    minutes = (sec % 3600) // 60\n",
        "    seconds = sec % 60\n",
        "    if hours > 0:\n",
        "        return f\"{hours:02d}:{minutes:02d}:{seconds:02d}\"\n",
        "    else:\n",
        "        return f\"{minutes:02d}:{seconds:02d}\"\n",
        "\n",
        "# 1. Logika perhitungan DURATION vs START_TIME\n",
        "if DURATION > 0 and END_TIME:\n",
        "    end_sec = time_to_seconds(END_TIME)\n",
        "    start_sec = max(0, end_sec - DURATION)\n",
        "    START_TIME = seconds_to_time(start_sec)\n",
        "    print(f\"⏱️ Menggunakan Durasi: {DURATION} detik. Start Time otomatis diset ke: {START_TIME}\")\n",
        "\n",
        "# 2. Cek dan install yt-dlp serta ffmpeg jika belum ada\n",
        "if not os.path.exists('/usr/local/bin/yt-dlp'):\n",
        "    print(\"📦 yt-dlp belum terinstal. Sedang menginstal yt-dlp...\")\n",
        "    !pip install -q yt-dlp\n",
        "    print(\"✅ yt-dlp berhasil diinstal!\")\n",
        "else:\n",
        "    print(\"✅ yt-dlp sudah tersedia.\")\n",
        "\n",
        "if not os.path.exists('/usr/bin/ffmpeg'):\n",
        "    print(\"📦 Menginstal ffmpeg...\")\n",
        "    !apt-get update -qq && apt-get install -y -qq ffmpeg\n",
        "    print(\"✅ ffmpeg berhasil diinstal!\")\n",
        "\n",
        "# 3. Buat string unik acak (5 karakter) untuk penamaan file\n",
        "def generate_random_string(length=5):\n",
        "    letters = string.ascii_lowercase + string.digits\n",
        "    return ''.join(random.choice(letters) for i in range(length))\n",
        "\n",
        "unique_str = generate_random_string(5)\n",
        "\n",
        "# 4. Format info potongan detik untuk nama file\n",
        "time_info_str = f\"{START_TIME.replace(':', '-')}_to_{END_TIME.replace(':', '-')}\"\n",
        "\n",
        "# 5. Tentukan folder tujuan dan nama file output\n",
        "output_folder = \"/content\"\n",
        "output_filename = f\"clip_{time_info_str}_{unique_str}.mp4\"\n",
        "output_path = os.path.join(output_folder, output_filename)\n",
        "\n",
        "# 6. Jalankan yt-dlp dengan parameter --download-sections\n",
        "section_range = f\"*{START_TIME}-{END_TIME}\"\n",
        "\n",
        "print(f\"\\n🚀 Memulai proses download & potong video...\")\n",
        "print(f\"🔗 URL: {URL}\")\n",
        "print(f\"⏱️ Rentang Waktu: {START_TIME} sampai {END_TIME}\")\n",
        "print(f\"📁 Output: {output_path}\\n\")\n",
        "\n",
        "# Perintah yt-dlp\n",
        "command = [\n",
        "    \"yt-dlp\",\n",
        "    \"--download-sections\", section_range,\n",
        "    \"-f\", \"bv*+ba/b\",\n",
        "    \"--merge-output-format\", \"mp4\",\n",
        "    \"-o\", output_path,\n",
        "    URL\n",
        "]\n",
        "\n",
        "# Eksekusi perintah\n",
        "result = subprocess.run(command)\n",
        "\n",
        "if result.returncode == 0 and os.path.exists(output_path):\n",
        "    print(f\"\\n🎉 Berhasil! Video klip tersimpan di:\\n👉 {output_path}\")\n",
        "else:\n",
        "    print(\"\\n❌ Terjadi kesalahan saat mendownload atau memotong video. Periksa kembali URL dan format waktu Anda.\")"
