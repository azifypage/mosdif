        "#@title 📥 4. Unduh Model Weights Resmi Workflow LTX-2.5 { run: \"auto\" }\n",
        "\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "# Pastikan aria2 terpasang untuk download multi-thread berkecepatan tinggi\n",
        "!which aria2c > /dev/null || (apt-get update -qq && apt-get install -y aria2 -qq)\n",
        "\n",
        "comfy_models = Path('/content/ComfyUI/models')\n",
        "diff_dir = comfy_models / 'diffusion_models'\n",
        "loras_dir = comfy_models / 'loras'\n",
        "text_dir = comfy_models / 'text_encoders'\n",
        "vae_dir = comfy_models / 'vae'\n",
        "upscale_dir = comfy_models / 'latent_upscale_models'\n",
        "\n",
        "for d in [diff_dir, loras_dir, text_dir, vae_dir, upscale_dir]:\n",
        "    d.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# 1. Base DiT Model (Official Workflow Node 443)\n",
        "dit_name = 'ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors'\n",
        "dit_path = diff_dir / dit_name\n",
        "if not dit_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh Base DiT Model ({dit_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {diff_dir} -o {dit_name} \"https://huggingface.co/osantinello/LTX25_Models/resolve/main/{dit_name}\"\n",
        "else:\n",
        "    print(f'✅ Base DiT Model ({dit_name}) sudah siap di cache.')\n",
        "\n",
        "# 2. Official BFS Head Swap LoRA (Node 610)\n",
        "lora_name = 'head_swap_ltx25_r128_v1.1.safetensors'\n",
        "lora_path = loras_dir / lora_name\n",
        "if not lora_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh BFS Head Swap LoRA ({lora_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {loras_dir} -o {lora_name} \"https://huggingface.co/Alissonerdx/BFS-Best-Face-Swap-Video/resolve/main/ltx-2.5/{lora_name}\"\n",
        "else:\n",
        "    print(f'✅ BFS Head Swap LoRA ({lora_name}) sudah siap di cache.')\n",
        "# Buat symlink nama alternatif yang dipakai di workflow\n",
        "!ln -sf {lora_path} {loras_dir}/head_swap_ltx25_v1_1_r128.safetensors 2>/dev/null || true\n",
        "\n",
        "# 3. Gemma-4 Text Encoder (Node 446)\n",
        "clip_name = 'gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors'\n",
        "clip_path = text_dir / clip_name\n",
        "if not clip_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh Text Encoder Gemma-4 ({clip_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {text_dir} -o {clip_name} \"https://huggingface.co/osantinello/LTX25_Models/resolve/main/{clip_name}\"\n",
        "else:\n",
        "    print(f'✅ Text Encoder ({clip_name}) sudah siap di cache.')\n",
        "\n",
        "# 4. Video VAE & Audio VAE (Node 453 & Node 427)\n",
        "v_vae_name = 'ltx-2.5-video-vae-bf16.safetensors'\n",
        "v_vae_path = vae_dir / v_vae_name\n",
        "if not v_vae_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh Video VAE ({v_vae_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {vae_dir} -o {v_vae_name} \"https://huggingface.co/osantinello/LTX25_Models/resolve/main/{v_vae_name}\"\n",
        "else:\n",
        "    print(f'✅ Video VAE ({v_vae_name}) sudah siap di cache.')\n",
        "\n",
        "a_vae_name = 'ltx-2.5-audio-vae-bf16.safetensors'\n",
        "a_vae_path = vae_dir / a_vae_name\n",
        "if not a_vae_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh Audio VAE ({a_vae_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {vae_dir} -o {a_vae_name} \"https://huggingface.co/osantinello/LTX25_Models/resolve/main/{a_vae_name}\"\n",
        "else:\n",
        "    print(f'✅ Audio VAE ({a_vae_name}) sudah siap di cache.')\n",
        "\n",
        "# 5. Latent Upscaler (Node 431)\n",
        "upscale_name = 'ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors'\n",
        "upscale_path = upscale_dir / upscale_name\n",
        "if not upscale_path.is_file():\n",
        "    print(f'\\n⚡ Mengunduh Latent Upscaler ({upscale_name})...')\n",
        "    !aria2c -c -x 16 -s 16 -k 1M -d {upscale_dir} -o {upscale_name} \"https://huggingface.co/osantinello/LTX25_Models/resolve/main/{upscale_name}\"\n",
        "else:\n",
        "    print(f'✅ Latent Upscaler ({upscale_name}) sudah siap di cache.')\n",
        "\n",
        "print('\\n🎉 Semua 5 Model Bobot Resmi Workflow BFS sudah 100% lengkap dan siap!')\n"
      ]
    },
