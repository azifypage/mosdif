        "# 1. Clone atau update mosdif repository\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "if not os.path.exists('/content/mosdif'):\n",
        "    print('Mengunduh mosdif repository...')\n",
        "    !git clone https://github.com/azifypage/mosdif.git /content/mosdif\n",
        "else:\n",
        "    print('Memperbarui mosdif repository...')\n",
        "    !git -C /content/mosdif pull || true\n",
        "\n",
        "%cd /content/mosdif\n",
        "\n",
        "# 2. Clone ComfyUI backend jika belum ada\n",
        "if not os.path.exists('/content/ComfyUI'):\n",
        "    print('Mengunduh ComfyUI backend...')\n",
        "    !git clone https://github.com/comfyanonymous/ComfyUI /content/ComfyUI\n",
        "    !pip install -q -r /content/ComfyUI/requirements.txt\n",
        "\n",
        "# 3. Clone semua Custom Nodes yang dibutuhkan workflow resmi BFS\n",
        "custom_nodes_dir = Path('/content/ComfyUI/custom_nodes')\n",
        "custom_nodes_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "official_nodes = [\n",
        "    ('ComfyUI-BFSNodes', 'https://github.com/alisson-anjos/ComfyUI-BFSNodes.git'),\n",
        "    ('ComfyUI-VideoHelperSuite', 'https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git'),\n",
        "    ('ComfyUI-KJNodes', 'https://github.com/kijai/ComfyUI-KJNodes.git'),\n",
        "]\n",
        "\n",
        "for name, git_url in official_nodes:\n",
        "    target_path = custom_nodes_dir / name\n",
        "    if not target_path.exists():\n",
        "        print(f'Mengunduh custom node: {name}...')\n",
        "        !git clone --depth 1 {git_url} {target_path}\n",
        "    else:\n",
        "        print(f'Memperbarui custom node: {name}...')\n",
        "        !git -C {target_path} pull || true\n",
        "\n",
        "    req = target_path / 'requirements.txt'\n",
        "    if req.is_file():\n",
        "        print(f'Menginstall dependensi untuk {name}...')\n",
        "        !pip install -q -r {req}\n",
        "\n",
        "# 4. Install websocket-client untuk live streaming progress WebSocket ComfyUI\n",
        "!pip install -q websocket-client requests\n",
        "print('\\n✅ Setup workspace, ComfyUI backend, dan semua Custom Nodes resmi BFS selesai!')\n"
      ]
    },
